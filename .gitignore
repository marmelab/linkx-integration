# Node
**/node_modules

**/dist

**/*.local
**/.env

**/.DS_Store

.claude/settings.local.json

.pnpm-store


# Symfony
# Cache and logs (Symfony2)
packages/web/app/cache/*
packages/web/app/logs/*
!packages/webapp/cache/.gitkeep
!packages/webapp/logs/.gitkeep

# Email spool folder
/packages/web/app/spool/*

# Cache, session files and logs (Symfony3)
/packages/web/var/cache/*
/packages/web/var/logs/*
/packages/web/var/sessions/*
!packages/web/var/cache/.gitkeep
!packages/web/var/logs/.gitkeep
!packages/web/var/sessions/.gitkeep

# Logs (Symfony4)
/packages/web/var/log/*
!packages/web/var/log/.gitkeep

# Parameters
packages/web/app/config/parameters.yml
packages/web/app/config/parameters.ini

# Managed by Composer
/packages/web/app/bootstrap.php.cache
/packages/web/var/bootstrap.php.cache
/packages/web/bin/*
!packages/web/bin/console
!packages/web/bin/symfony_requirements
/packages/web/vendor/

# Assets and user uploads
/packages/web/web/bundles/
/packages/web/web/uploads/

# PHPUnit
/packages/web/app/phpunit.xml
/packages/web/phpunit.xml

# Build data
/packages/web/build/

# Backup entities generated with doctrine:generate:entities command
packages/web/**/Entity/*~

# Embedded web-server pid file
/packages/web/.web-server-pid