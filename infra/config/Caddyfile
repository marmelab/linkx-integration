{
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
		client_ip_headers Cf-Connecting-IP
	}
}

linkx-integration.marmelab.com {
	
	redir /apk /apk/ permanent
	redir /admin /admin/ permanent
	handle_path /apk/* {
		encode gzip
		root * /apk
		file_server {
			browse
			index latest.apk
		}
	}
	handle_path /admin/* {
		# No auth: this is only the admin front-end and requires login to php
		root * /admin
		encode gzip
		try_files {path} /index.html
		file_server
	}
    handle {
        # Http is acceptable because every message is within the docker virtual network
        reverse_proxy http://php
    }
}