DEFAULT_URI=localhost
POSTGRES_USER=linkx
POSTGRES_PASSWORD=changeme
POSTGRES_DB=linkx
POSTGRES_VERSION=18
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres-dev:5432/${POSTGRES_DB}?serverVersion=${POSTGRES_VERSION:-18}&charset=${POSTGRES_CHARSET:-utf8}"
PGADMIN_MAIL=changeme@marmelab.com
PGADMIN_PW=changeme
SERVER_NAME=http://localhost
SECONDARY_SERVER_NAME=http://192.168.86.35
RULES_SERVICE_URI=http://node-linkx:3000
APP_ENV=dev

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=changeme
###< lexik/jwt-authentication-bundle ###
