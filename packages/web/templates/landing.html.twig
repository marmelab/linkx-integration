{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link href="{{ asset('styles/landing.css') }}" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
    <div id="container">
        <form action="/game" method="GET">
            <button type="submit">Jouer sur le même ordinateur</button>
            <input type="text" name="state" value="" placeholder="Reprendre depuis un état existant...">
        </form>
        <form action="/online-game">
            <button type="submit">Jouer à distance</button>
        </form>
    </div>
{% endblock %}