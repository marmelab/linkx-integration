{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/security.css') }}"/>
{% endblock %}

{% block body %}
    <form method="post">
        {% if error %}
            <div class="alert alert-danger">
                <p>{{ error }}</p>
                {% for errorElement in errorList %}
                    <p>{{ errorElement.propertyPath }}: {{ errorElement.message }}</p>
                {% endfor %}
            </div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3">
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
            </div>
        {% endif %}

        <h1 class="h3 mb-3 font-weight-normal">Please register</h1>
        <div class="form-container">
            <div class="form-field">
                <label for="username">Username</label>
                <input type="text" name="_username" id="username" class="form-control" autocomplete="username" required autofocus>
            </div>
            <div class="form-field">
                <label for="password">Password</label>
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
            </div>
            <div class="form-field">
                <label for="display-name">Display Name</label>
                <input type="text" name="display-name" id="display-name" class="form-control" autocomplete="none"/>
            </div>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
        </div>

        <button class="btn btn-lg btn-primary" type="submit">
            Register
        </button>
        <p><a href="/login">Already have an account ? Sign in</a></p>
    </form>
{% endblock %}
